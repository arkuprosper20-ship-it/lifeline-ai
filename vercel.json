{
  "version": 2,
  "builds": [
    {
      "src": "**/*",
      "use": "@vercel/static",
      "config": {
        "headers": {
          "cache-control": "no-cache, no-store, must-revalidate"
        }
      }
    },
    {
      "src": "/api/notify.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/$1.js" },
    {
      "src": "/(.*)",
      "dest": "/index.html",
      "status": 200,
      "headers": {
        "cache-control": "no-cache, no-store, must-revalidate"
      }
    }
  ]
}