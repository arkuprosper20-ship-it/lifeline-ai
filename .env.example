# LIFELINE AI — Environment Variables
# Copy this file to .env and fill in your values.
# The application works without ANY of these variables using the
# local rules engine and device-based fallbacks (no Twilio/SMS API needed).

# Groq Cloud AI (optional — local rules engine is used as fallback)
GROQ_API_KEY=            # Your Groq Cloud API key
GROQ_MODEL=              # Default: llama-3.3-70b-versatile

# SMS provider (optional — tel:/sms: links used as fallback)
SMS_PROVIDER=            # e.g. twilio — leave blank to use Device SMS fallback

# Optional Twilio configuration (only used when SMS_PROVIDER=twilio)
SMS_ACCOUNT_SID=
SMS_AUTH_TOKEN=
SMS_FROM=

# Twilio Status Callback (for delivery receipts)
# Set this to your production domain's webhook endpoint
TWILIO_STATUS_CALLBACK_URL=   # e.g. https://yourdomain.com/api/twilio-webhook

# Base URL (used to construct webhook callback URLs)
BASE_URL=                # e.g. https://yourdomain.com

# Email provider (optional)
EMAIL_PROVIDER=          # e.g. ses
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=

# Webhook (optional — receives structured JSON payload per contact)
WEBHOOK_URL=             # Your organization webhook URL
WEBHOOK_SECRET=          # Optional webhook signing secret

# Allowed origins for API requests (for production)
ALLOWED_ORIGINS=         # Comma-separated list, e.g. https://yourdomain.com

# Firebase Config (optional — local auth is used by default)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=

# WebSocket server (for real-time coordination)
WS_URL=                  # e.g. wss://yourdomain.com — optional
