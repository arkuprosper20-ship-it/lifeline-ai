# LIFELINE AI — Environment Variables
# Copy this file to .env and fill in your values.
# The application works without any of these variables (local fallback mode).

# Groq Cloud AI (optional — local rules engine is used as fallback)
GROQ_API_KEY=            # Your Groq Cloud API key
GROQ_MODEL=              # Default: llama-3.3-70b-versatile

# SMS provider (optional — tel: links used as fallback)
SMS_PROVIDER=            # e.g., twilio
SMS_ACCOUNT_SID=
SMS_AUTH_TOKEN=
SMS_FROM=

# Email provider (optional)
EMAIL_PROVIDER=           # e.g., ses
EMAIL_FROM_ADDRESS=      # From email address
EMAIL_FROM_NAME=         # From display name

# Webhook (optional — receives structured JSON payload)
WEBHOOK_URL=             # Your organization webhook URL
WEBHOOK_SECRET=           # Optional webhook signing secret

# Allowed origins for API requests (for production)
ALLOWED_ORIGINS=         # Comma-separated list, e.g., https://yourdomain.com

# Firebase Config (optional — local auth is used by default)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
